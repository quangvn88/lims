# Để TRỐNG để fetch dùng đường dẫn tương đối (/dev/lims/plx/api/) -> đi qua
# proxy của CRA dev server (field "proxy" trong package.json) nên browser thấy
# same-origin, không còn CORS. Gateway :8001 không trả Access-Control-Allow-Origin
# và còn chặn preflight OPTIONS bằng 401 nên gọi trực tiếp từ localhost sẽ bị block.
# Production không cần: app chạy cùng host với API nên đã same-origin.
REACT_APP_BASE_URL=
REACT_APP_SERVER_URL_CHAT=http://erp.petrolimex.com.vn:8001
REACT_APP_API=/dev/lims/plx/api/
# Tắt source map để không hiện cảnh báo "Failed to parse source map" từ docx-preview/pptx-preview
GENERATE_SOURCEMAP=false